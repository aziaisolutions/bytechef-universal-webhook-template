"{\n    \"label\" : \"Lead Ingestion & Dispatch Pipeline\",\n    \"description\" : \"Captures incoming lead webhooks, normalizes parameters, and routes data downstream.\",\n    \"inputs\" : [ ],\n    \"triggers\" : [\n        {\n            \"description\" : \"Receives raw JSON payloads from inbound web forms or lead sources and returns an immediate HTTP 200 response to prevent upstream timeouts.\",\n            \"label\" : \"Webhook Trigger (Lead Ingestion)\",\n            \"name\" : \"trigger_1\",\n            \"parameters\" : { },\n            \"type\" : \"webhook/v1/autoRespondWithHTTP200\"\n        }\n    ],\n    \"tasks\" : [\n        {\n            \"description\" : \"Transforms and routes structured lead parameters (name, email, company, intent) to downstream endpoints or CRM systems.\",\n            \"label\" : \"Downstream CRM / Webhook Dispatch\",\n            \"name\" : \"httpClient_1\",\n            \"parameters\" : {\n                \"allowUnauthorizedCerts\" : false,\n                \"responseType\" : \"JSON\",\n                \"responseContentType\" : \"application/octet-stream\",\n                \"fullResponse\" : false,\n                \"followAllRedirects\" : false,\n                \"followRedirect\" : false,\n                \"ignoreResponseCode\" : false,\n                \"timeout\" : 1000,\n                \"uri\" : \"https://httpbin.org/post\",\n                \"body\" : {\n                    \"bodyContentType\" : \"JSON\",\n                    \"bodyContent\" : {\n                        \"event\" : \"lead_received\",\n                        \"name\" : \"${trigger_1.body.name}\",\n                        \"email\" : \"${trigger_1.body.email}\",\n                        \"company\" : \"${trigger_1.body.company}\",\n                        \"intent\" : \"${trigger_1.body.intent}\"\n                    }\n                }\n            },\n            \"type\" : \"httpClient/v2/post\",\n            \"metadata\" : {\n                \"ui\" : {\n                    \"dynamicPropertyTypes\" : {\n                        \"uri\" : \"STRING\",\n                        \"body\" : \"OBJECT\",\n                        \"body.bodyContent.event\" : \"STRING\",\n                        \"body.bodyContent.name\" : \"STRING\",\n                        \"body.bodyContent.email\" : \"STRING\",\n                        \"body.bodyContent.company\" : \"STRING\",\n                        \"body.bodyContent.intent\" : \"STRING\"\n                    }\n                }\n            }\n        }\n    ]\n}"